{
  "expo": {
    "name": "Finora",
    "slug": "finora-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-mark.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo-full.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.finora.personal"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-mark.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.finora.personal",
      "versionCode": 1
    }
  }
}
